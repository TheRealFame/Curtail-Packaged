#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	meson setup builddir

override_dh_auto_build:
	meson compile -C builddir

override_dh_auto_install:
	meson install -C builddir --destdir debian/curtail

override_dh_auto_clean:
	rm -rf builddir

override_dh_install:
	dh_install
	# All data files (metainfo, desktop, icons, schemas, dbus service)
	# are installed by meson's install rule via dh_auto_install.